{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homeo-x.org/schemas/claim.schema.json",
  "title": "Claim",
  "description": "A graded, sourced assertion. The claim record of BIO_Evidence_and_Provenance.",
  "type": "object",
  "required": ["id","subject","predicate","object","evidence_class","source_type",
               "species","population","date_asserted","limitations","assigned_by"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^CLM:[a-z0-9-]+$"},
    "subject": {"type": "string", "description": "Entity or Relationship id"},
    "predicate": {"type": "string", "minLength": 1},
    "object": {"description": "Entity reference, categorical value, or quantity"},
    "unit": {"type": "string",
      "description": "UCUM code. Required when object is numeric (INV-04)"},
    "evidence_class": {"enum": ["EVC-1","EVC-2","EVC-3","EVC-4","EVC-5","EVC-6","EVC-7","EVC-8"]},
    "sources": {"type": "array", "items": {
      "type": "object", "required": ["citation", "identifier"], "additionalProperties": false,
      "properties": {"citation": {"type": "string"},
        "identifier": {"type": "string", "description": "DOI, ISBN, accession, or ontology term"},
        "licence_tier": {"enum": ["T0", "T1", "T1N", "T2"]}}},
      "description": "Required unless evidence_class is EVC-8 (INV-07)"},
    "source_type": {"enum": ["primary research","systematic review","reference textbook",
      "anatomical atlas","imaging dataset","curated database","derived model","expert assertion"]},
    "species": {"type": "string",
      "description": "Homo sapiens, the actual species, or 'not applicable' (INV-12)"},
    "transfer_justification": {"type": "string", "minLength": 1,
      "description": "Required when species is not Homo sapiens (INV-12)"},
    "population": {"type": "string", "minLength": 1,
      "description": "'unspecified in source' is valid and informative"},
    "conditions": {"type": "object", "additionalProperties": true,
      "properties": {"preparation": {"enum": ["in vivo","in vitro","ex vivo","computational"]},
        "temperature_c": {"type": "number"}, "notes": {"type": "string"}},
      "description": "Required when quantitative"},
    "date_asserted": {"type": "string", "format": "date"},
    "limitations": {"type": "string", "minLength": 1,
      "description": "'none identified' must be a deliberate entry"},
    "conflicts_with": {"type": "array", "items": {"type": "string"}},
    "assigned_by": {"type": "string",
      "description": "Must be a human reviewer id when class is EVC-1 or EVC-2 (BR-002)"},
    "provenance_source": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"evidence_class": {"const": "EVC-8"}}},
     "then": true,
     "else": {"required": ["sources"]}},
    {"if": {"properties": {"evidence_class": {"enum": ["EVC-1", "EVC-2"]}}},
     "then": {"properties": {"assigned_by": {"pattern": "^human:"}}}}
  ]
}
