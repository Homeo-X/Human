{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://homeo-x.org/schemas/scale_contract.schema.json",
  "title": "ScaleContract",
  "description": "An SCL level contract. An undeclared level is how a model overclaims.",
  "type": "object",
  "required": ["id","level","represents","representation_mode","data_model","spatial_model",
               "functional_model","evidence_model","uncertainty_model","computational_cost",
               "resolution_limit"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^SCL-[0-9]{2}$"},
    "level": {"type": "integer", "minimum": 0, "maximum": 10},
    "represents": {"type": "string", "minLength": 1},
    "representation_mode": {"type": "array",
      "items": {"enum": ["enumerated","typed","statistical","exemplar","referenced","absent"]},
      "minItems": 1},
    "data_model": {"type": "string", "minLength": 1},
    "spatial_model": {"type": "string", "minLength": 1},
    "functional_model": {"type": "string", "minLength": 1},
    "evidence_model": {"type": "string", "minLength": 1},
    "uncertainty_model": {"type": "string", "minLength": 1},
    "computational_cost": {"type": "string", "minLength": 1},
    "resolution_limit": {"type": "string", "minLength": 1,
      "description": "The sentence that stops the project overclaiming (BRB-01)"}
  }
}
